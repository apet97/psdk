# pumble-sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: PUMBLESDK_
#
# Security environment variables:
PUMBLESDK_API_KEY_AUTH=your_apikeyauth_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
PUMBLESDK_DEBUG=true
