{
  "name": "pumble-keys-sdk",
  "version": "0.3.21",
  "author": "apet97 (https://github.com/apet97)",
  "bin": {
    "pumble-keys": "./bin/pumble-keys-cli.mjs",
    "pumble-keys-mcp": "./bin/pumble-keys-mcp.mjs"
  },
  "bugs": {
    "url": "https://github.com/apet97/psdk/issues"
  },
  "description": "Unofficial TypeScript SDK and MCP server for the Pumble API-Keys add-on",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json",
    "./core.js": {
      "source": "./src/core.ts",
      "types": "./esm/core.d.ts",
      "default": "./esm/core.js"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./esm/types/index.d.ts",
      "default": "./esm/types/index.js"
    },
    "./models": {
      "source": "./src/models/index.ts",
      "types": "./esm/models/index.d.ts",
      "default": "./esm/models/index.js"
    },
    "./models/errors": {
      "source": "./src/models/errors/index.ts",
      "types": "./esm/models/errors/index.d.ts",
      "default": "./esm/models/errors/index.js"
    },
    "./models/operations": {
      "source": "./src/models/operations/index.ts",
      "types": "./esm/models/operations/index.d.ts",
      "default": "./esm/models/operations/index.js"
    },
    "./extensions/index.js": {
      "source": "./src/extensions/index.ts",
      "types": "./esm/extensions/index.d.ts",
      "default": "./esm/extensions/index.js"
    },
    "./extensions/webhooks.js": {
      "source": "./src/extensions/webhooks.ts",
      "types": "./esm/extensions/webhooks.d.ts",
      "default": "./esm/extensions/webhooks.js"
    },
    "./extensions/telemetry.js": {
      "source": "./src/extensions/telemetry.ts",
      "types": "./esm/extensions/telemetry.d.ts",
      "default": "./esm/extensions/telemetry.js"
    },
    "./extensions/testing/index.js": {
      "source": "./src/extensions/testing/index.ts",
      "types": "./esm/extensions/testing/index.d.ts",
      "default": "./esm/extensions/testing/index.js"
    },
    "./extensions/app/index.js": {
      "source": "./src/extensions/app/index.ts",
      "types": "./esm/extensions/app/index.d.ts",
      "default": "./esm/extensions/app/index.js"
    },
    "./extensions/app/socket-mode.js": {
      "source": "./src/extensions/app/socket-mode.ts",
      "types": "./esm/extensions/app/socket-mode.d.ts",
      "default": "./esm/extensions/app/socket-mode.js"
    },
    "./lib/http": {
      "source": "./src/lib/http.ts",
      "types": "./esm/lib/http.d.ts",
      "default": "./esm/lib/http.js"
    }
  },
  "files": [
    "bin/audit-log-shim.mjs",
    "bin/dry-run-shim.mjs",
    "bin/mcp-server.js",
    "bin/pumble-keys-cli.mjs",
    "bin/pumble-mcp-args.mjs",
    "bin/pumble-mcp-curated.js",
    "bin/pumble-keys-mcp.mjs",
    "docs/API-REFERENCE.md",
    "docs/ERRORS.md",
    "docs/INTEGRATION-USAGE.md",
    "docs/MCP-SAFETY.md",
    "docs/PACKAGE-SPLIT.md",
    "docs/QUICKSTART.md",
    "docs/STABILITY.md",
    "docs/SUPPORT.md",
    "docs/MIGRATING.md",
    "docs/verification/v0.4.0.md",
    "esm",
    "knowledge",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "homepage": "https://github.com/apet97/psdk#readme",
  "keywords": [
    "pumble",
    "sdk",
    "unofficial",
    "typescript",
    "api-client",
    "mcp",
    "cli",
    "webhooks"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apet97/psdk.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./esm/index.js",
  "sideEffects": false,
  "scripts": {
    "lint": "oxlint --max-warnings=0 --deny-warnings src tests scripts 'bin/*.mjs' examples",
    "build:mcp": "bun src/mcp-server/build.mts",
    "build": "npm run build:mcp && tsgo",
    "prepublishOnly": "npm run verify:offline",
    "test:live:replay": "PUMBLE_REPLAY=search-all-live NODE_OPTIONS=\"--import ./scripts/replayer.mjs\" vitest run tests/search-all.test.ts",
    "test:cli": "vitest run tests/cli.test.ts",
    "test:mcp:safety": "vitest run tests/mcp-agent-safety.test.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:unit": "vitest run tests/categorize-error.test.ts tests/resolve.test.ts tests/with-retries.test.ts tests/rate-limiter.test.ts tests/retries.test.ts tests/extensions.test.ts tests/facade-internals.test.ts tests/facade-writes.test.ts tests/client-facade.test.ts tests/client-resolver-cache.test.ts tests/thread-context.test.ts tests/webhooks.test.ts tests/socket-mode.test.ts tests/pumble-app.test.ts tests/telemetry.test.ts tests/testing-helpers.test.ts tests/write-plan.test.ts",
    "verify:live": "node scripts/verify-live.mjs",
    "test:arazzo:replay": "node scripts/run-arazzo-live.mjs --replay arazzo-26-workflows",
    "test:coverage": "vitest run --coverage",
    "test:examples": "vitest run tests/examples.test.ts",
    "test:smoke": "vitest run tests/package-metadata.test.ts tests/examples.test.ts tests/package-split-dry-run.test.ts tests/ci-workflow.test.ts tests/release-workflow.test.ts",
    "goals:check": "node scripts/goal-check.mjs",
    "test": "tsc -p tsconfig.tests.json --noEmit && vitest run",
    "test:fixtures:scan": "node scripts/scan-fixtures.mjs",
    "verify": "npm run verify:offline && npm run verify:live",
    "spec:audit": "node scripts/spec-quality-audit.mjs",
    "test:mcp:live": "node scripts/run-mcp-live.mjs",
    "verify:offline": "npm run goals:check && node scripts/attribution-audit.mjs && node scripts/version-consistency.mjs && npm run spec:audit && npm run build && npm run lint && npm test && npm run test:arazzo:replay && npm run test:live:replay && npm run test:fixtures:scan && npm run test:pack -- --skip-build",
    "test:arazzo": "node scripts/run-arazzo-live.mjs",
    "test:mcp": "vitest run tests/mcp-agent-safety.test.ts tests/mcp-curated-read-tools.test.ts tests/mcp-curated-resources.test.ts tests/mcp-curated-targets.test.ts tests/mcp-curated-write-tools.test.ts tests/mcp-tool-manifest.test.ts tests/pumble-mcp.test.ts tests/pumble-mcp-curated.test.ts tests/dry-run-shim.test.ts",
    "prebuild": "node scripts/normalize-package.mjs",
    "test:docs": "vitest run tests/docs.test.ts tests/release-evidence.test.ts tests/patch-burndown.test.ts tests/spec-quality-audit.test.ts tests/goal-registry.test.ts",
    "fixtures:minimize": "node scripts/minimize-fixtures.mjs",
    "package-split:dry-run": "node scripts/package-split-dry-run.mjs",
    "test:facade:live": "node scripts/run-facade-live.mjs",
    "test:guards": "vitest run tests/generated-runtime-patch.test.ts tests/generated-request-validation.test.ts tests/response-validation.test.ts tests/debug-redaction.test.ts",
    "test:live": "vitest run tests/search-all.test.ts"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@stricli/core": "^1.1.1",
    "@types/express": "^4.17.21",
    "@typescript/native-preview": "7.0.0-dev.20260302.1",
    "bun": "1.2.17",
    "bun-types": "1.2.17",
    "express": "^4.21.2",
    "oxlint": "^1.60.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9",
    "yaml": "^2.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jsonpath-rfc9535": "1.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
