{
  "name": "pumble-sdk",
  "version": "0.3.21",
  "description": "TypeScript SDK and MCP server for the Pumble API-Keys add-on",
  "license": "MIT",
  "author": "Pumble SDK Team",
  "bin": {
    "pumble": "./bin/pumble-cli.mjs",
    "pumble-mcp": "./bin/pumble-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/audit-log-shim.mjs",
    "bin/dry-run-shim.mjs",
    "bin/mcp-server.js",
    "bin/pumble-cli.mjs",
    "bin/pumble-mcp-args.mjs",
    "bin/pumble-mcp-curated.js",
    "bin/pumble-mcp.mjs",
    "docs/INTEGRATION-USAGE.md",
    "docs/PACKAGE-SPLIT.md",
    "docs/QUICKSTART.md",
    "docs/llms.txt",
    "esm",
    "src"
  ],
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "type": "module",
  "main": "./esm/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./esm/types/index.d.ts",
      "default": "./esm/types/index.js"
    },
    "./models/errors": {
      "source": "./src/models/errors/index.ts",
      "types": "./esm/models/errors/index.d.ts",
      "default": "./esm/models/errors/index.js"
    },
    "./models": {
      "source": "./src/models/index.ts",
      "types": "./esm/models/index.d.ts",
      "default": "./esm/models/index.js"
    },
    "./models/operations": {
      "source": "./src/models/operations/index.ts",
      "types": "./esm/models/operations/index.d.ts",
      "default": "./esm/models/operations/index.js"
    },
    "./*.js": {
      "source": "./src/*.ts",
      "types": "./esm/*.d.ts",
      "default": "./esm/*.js"
    },
    "./*": {
      "source": "./src/*.ts",
      "types": "./esm/*.d.ts",
      "default": "./esm/*.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "verify": "npm run verify:offline && npm run verify:live",
    "verify:offline": "npm run spec:audit && npm run build && npm run lint && npm test && npm run test:arazzo:replay && npm run test:live:replay && npm run test:fixtures:scan && npm run test:pack -- --skip-build && npm run bench:smoke",
    "verify:live": "node scripts/verify-live.mjs",
    "lint": "oxlint --max-warnings=0 --deny-warnings src/**/*.ts src/**/*.tsx",
    "spec:audit": "node scripts/spec-quality-audit.mjs",
    "prebuild": "node scripts/normalize-package.mjs",
    "build:mcp": "bun src/mcp-server/build.mts",
    "build": "npm run build:mcp && tsgo",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:arazzo": "node scripts/run-arazzo-live.mjs",
    "test:arazzo:replay": "node scripts/run-arazzo-live.mjs --replay arazzo-26-workflows",
    "test:examples": "vitest run tests/examples.test.ts",
    "test:fixtures:scan": "node scripts/scan-fixtures.mjs",
    "test:live": "vitest run tests/search-all.test.ts",
    "test:live:replay": "PUMBLE_REPLAY=search-all-live NODE_OPTIONS=\"--import ./scripts/replayer.mjs\" vitest run tests/search-all.test.ts",
    "test:mcp:safety": "vitest run tests/mcp-agent-safety.test.ts",
    "test:pack": "node scripts/pack-smoke.mjs",
    "fixtures:minimize": "node scripts/minimize-fixtures.mjs",
    "bench:smoke": "node scripts/perf-smoke.mjs",
    "package-split:dry-run": "node scripts/package-split-dry-run.mjs"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@stricli/core": "^1.1.1",
    "@types/express": "^4.17.21",
    "@typescript/native-preview": "7.0.0-dev.20260302.1",
    "bun": "1.2.17",
    "bun-types": "1.2.17",
    "express": "^4.21.2",
    "oxlint": "^1.60.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.9",
    "yaml": "^2.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jsonpath-rfc9535": "1.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
